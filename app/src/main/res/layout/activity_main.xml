<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        android:id="@+id/tv_location_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location Service Disabled"
        android:textSize="18sp"
        android:textColor="#000000"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_health_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Health Service Disabled"
        android:textSize="18sp"
        android:textColor="#000000"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_microphone_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Microphone Service Disabled"
        android:textSize="18sp"
        android:textColor="#000000"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_run_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="00:00"
        android:textSize="56sp"
        android:textColor="#000000"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_run_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Run" />

        <Button
            android:id="@+id/btn_stop_run"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:enabled="false"
            android:text="Stop" />
    </LinearLayout>

</LinearLayout>